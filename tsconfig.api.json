{
  /*
   * The Vercel Functions folder, type-checked on its own.
   *
   * `tsconfig.app.json` deliberately `include`s only `src`, so `npx tsc -b`
   * gives *zero* signal about `api/` — and Vercel's Node runtime resolves that
   * folder under `nodenext` rules, where a relative import missing its `.js`
   * suffix (`from '../src/data/people'` instead of `'../src/data/people.js'`)
   * type-checks fine locally but 500s the deployed function on every call.
   * `npm run typecheck:api` (wired into `build` and CI) closes that gap.
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api"]
}
