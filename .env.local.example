# Copy this file to `.env.local` and paste the values from
# Firebase console → Project settings → Your apps → Web app → SDK setup and configuration.
# Restart `npm run dev` after editing. Until all six are filled in, the app runs
# in demo mode: Google sign-in is disabled and progress stays in this browser.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary — question photos in the Кахут mode (see src/lib/cloudinary.ts).
# Dashboard → Cloud name, and Settings → Upload → Upload presets → add one with
# Signing Mode: Unsigned. No card required. Until both are filled in, the photo
# picker in Кахут simply does nothing — questions still publish without one.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Gemini — powers the AI persona chat (/ai) and the in-lesson "explain
# simpler" hint, via the server-only proxy at api/gemini.ts. Deliberately NOT
# a VITE_-prefixed variable: Vite inlines every VITE_ var into the client
# bundle at build time, which would put this key in plain sight in the page's
# JS for anyone to read. It is set once as a Vercel production env var
# instead (`vercel env add GEMINI_API_KEY production`) and never lives here
# or in any committed file. Get a free key at https://aistudio.google.com/apikey
# — without it, both AI features fall back to their offline/scripted paths.

# Firebase service account — makes the daily AI cap on api/gemini.ts
# transactional (exact, no lost updates). OPTIONAL: without it the cap still
# runs, over Firestore REST against an increment-only counter the caller
# cannot reset (see SECURITY.md) — just slightly less precise under a burst.
# 50 requests/day per user, 2000/day globally either way.
# The whole JSON key file's contents, as one single-line string (Firebase
# console → Project settings → Service accounts → Generate new private key).
# Same Vercel-only, non-VITE_-prefixed treatment as GEMINI_API_KEY above —
# `vercel env add FIREBASE_SERVICE_ACCOUNT_KEY production` — never here or in
# any committed file.
FIREBASE_SERVICE_ACCOUNT_KEY=

# ALLOW_UNMETERED_AI — set to 1 ONLY as a deliberate escape hatch to run the
# AI feature with no cap at all. With neither the service-account key nor a
# reachable Firestore for the REST counter, a request fails closed (429)
# unless this is set. Leave unset in normal operation.
# ALLOW_UNMETERED_AI=
