rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    /* ------------------------------ profile ------------------------------ */

    // The shape and bounds of one progress document. There is no server to
    // award XP, so the client holds the write credential for its own profile —
    // but "my own document" is not the same as "any bytes I like". Without the
    // checks below a signed-in user could `setDoc` `xp: 1e9` (or roll a
    // lifetime counter *back* to re-earn a one-time reward) straight past the
    // clamps in `src/lib/progress.ts`, which only run client-side.
    //
    // `progressCountersMonotonic` is applied on update only: every field that
    // is a lifetime total in `progress.ts` (never decreased on any legit path —
    // `Math.max` on merge, `+1`/`+xp` on write) may only stay equal or grow.
    // Streaks are deliberately absent from it: they reset to 0/1 by design.
    function validProfileShape(d) {
      return d.keys().hasOnly([
          'xp', 'streak', 'quizzesCompleted', 'unlockedBadges', 'totalVisits',
          'lastVisitDate', 'peopleViewed', 'timelineViewed', 'lessonProgress',
          'completedLessons', 'lessonQuizBest', 'sectionChecksDone',
          'avatarGender', 'displayedRankTier', 'displayedAvatarTier',
          'casualDuels', 'casualWins', 'casualStreak', 'recentCasualDuels',
          'rankedDuels', 'rankedWins', 'rankedStreak', 'recentRankedDuels',
        ])
        && d.xp is number && d.xp >= 0 && d.xp <= 10000000
        && d.streak is number && d.streak >= 0 && d.streak <= 100000
        && d.quizzesCompleted is number && d.quizzesCompleted >= 0 && d.quizzesCompleted <= 1000000
        && d.totalVisits is number && d.totalVisits >= 0 && d.totalVisits <= 1000000
        && d.casualDuels is number && d.casualDuels >= 0 && d.casualDuels <= 1000000
        && d.casualWins is number && d.casualWins >= 0 && d.casualWins <= 1000000
        && d.casualStreak is number && d.casualStreak >= 0 && d.casualStreak <= 100000
        && d.rankedDuels is number && d.rankedDuels >= 0 && d.rankedDuels <= 1000000
        && d.rankedWins is number && d.rankedWins >= 0 && d.rankedWins <= 1000000
        && d.rankedStreak is number && d.rankedStreak >= 0 && d.rankedStreak <= 100000
        && d.lastVisitDate is string && d.lastVisitDate.size() <= 10
        && d.timelineViewed is bool
        && d.unlockedBadges is list && d.unlockedBadges.size() <= 200
        && d.peopleViewed is list && d.peopleViewed.size() <= 5000
        && d.completedLessons is list && d.completedLessons.size() <= 2000
        && d.sectionChecksDone is list && d.sectionChecksDone.size() <= 20000
        && d.recentCasualDuels is list && d.recentCasualDuels.size() <= 8
        && d.recentRankedDuels is list && d.recentRankedDuels.size() <= 10
        && d.lessonProgress is map && d.lessonProgress.size() <= 2000
        && d.lessonQuizBest is map && d.lessonQuizBest.size() <= 2000
        && (d.avatarGender == null || d.avatarGender in ['m', 'f'])
        && (d.displayedRankTier == null
            || (d.displayedRankTier is int && d.displayedRankTier >= 0 && d.displayedRankTier <= 20))
        && (d.displayedAvatarTier == null
            || (d.displayedAvatarTier is int && d.displayedAvatarTier >= 0 && d.displayedAvatarTier <= 20));
    }

    // `prev` is the *stored* doc, only ever as complete as the client that last
    // wrote it — and `casualDuels`/`rankedWins` etc. are younger than the
    // cloud mirror itself, so a doc last written in Aug 2026 can be missing
    // them. Reading an absent map key is an evaluation error (which denies), so
    // every stored-side read goes through `.get(key, 0)`: a field the doc never
    // had reads as 0, and any new value is trivially "not a rollback".
    // Append-only collections get the same treatment by size.
    function progressCountersMonotonic(next, prev) {
      return next.xp >= prev.get('xp', 0) && next.xp <= prev.get('xp', 0) + 100000
        && next.quizzesCompleted >= prev.get('quizzesCompleted', 0)
        && next.totalVisits >= prev.get('totalVisits', 0)
        && next.casualDuels >= prev.get('casualDuels', 0)
        && next.casualWins >= prev.get('casualWins', 0)
        && next.rankedDuels >= prev.get('rankedDuels', 0)
        && next.rankedWins >= prev.get('rankedWins', 0)
        && next.completedLessons.size() >= prev.get('completedLessons', []).size()
        && next.unlockedBadges.size() >= prev.get('unlockedBadges', []).size()
        && next.peopleViewed.size() >= prev.get('peopleViewed', []).size()
        && next.sectionChecksDone.size() >= prev.get('sectionChecksDone', []).size()
        && (next.timelineViewed || !prev.get('timelineViewed', false));
    }

    // Scoped to `request.auth.uid == uid` — one user can never read or touch
    // another user's document.
    match /users/{uid}/profile/state {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && validProfileShape(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
        && validProfileShape(request.resource.data)
        && progressCountersMonotonic(request.resource.data, resource.data);
      allow delete: if false;
    }

    /* ------------------------------ battles ------------------------------ */
    /*
     * The 1v1 battle mode (see src/lib/battle.ts) is the only part of the app
     * where one signed-in user sees anything belonging to another. Every
     * collection below is shaped so that no client ever needs write permission
     * on a document another user owns: a player only ever writes their own
     * mirror, their own queue slot, and their own half of a shared match.
     */

    // Shared shape check for `battlePlayers/{uid}`: every field a client can
    // set on its own mirror, other than the scored ones (`weekXp`, `rating`),
    // which each allow-clause bounds separately since create and update cap
    // them differently. `avatarTierIndex`/`titleTierIndex` top out at
    // `ranks.length` (7, see src/lib/rankStyle.ts's `OWNER_TIER_INDEX`) — an
    // out-of-range value used to be able to reach this collection and crash
    // `RankBadge`/`rankTitleText` for every viewer of the leaderboard, since
    // those only clamped the *lower* bound. `updatedAt` has to stay near the
    // server's own clock (not just be *a* number) for the write-rate check
    // below to mean anything — a client that could freely backdate it could
    // otherwise reopen the throttle on every write. The tolerance is ±5
    // minutes, not ±5 seconds: real devices routinely run tens of seconds off
    // NTP, and a ±5s window was silently denying every `syncBattlePlayer`
    // write (and so every duel) for those users. ±5min still pins the value
    // close enough that the 60s scoring throttle keeps its intent.
    // Empty, or an https URL on the one host a shared identity photo ever comes
    // from (a Google account image). Reused by the Кахут player row below.
    function validSharedPhoto(url) {
      return url is string && url.size() <= 300
        && (url == '' || url.matches('https://lh3[.]googleusercontent[.]com(/.*)?'));
    }

    function validBattlePlayer(d) {
      return d.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'level', 'rating', 'weekXp',
          'weekStart', 'updatedAt', 'scoredAt', 'avatarGender',
          'avatarTierIndex', 'titleTierIndex',
        ])
        && d.displayName is string && d.displayName.size() <= 40
        // Every viewer of the weekly board fetches this as an <img src>. A
        // player photo is only ever the signed-in user's Google account image,
        // so the allow-list is exactly that one host — not the whole of
        // `res.cloudinary.com` (a shared multi-tenant CDN where any free
        // account could plant a tracking URL that still parses). Mirrors
        // `safePhotoURL` in `src/lib/safeUrl.ts`; Кахут question photos are a
        // different, host-authored field.
        && validSharedPhoto(d.photoURL)
        && d.level is number && d.level >= 1 && d.level <= 500
        && d.avatarTierIndex is number && d.avatarTierIndex >= 0 && d.avatarTierIndex <= 7
        && d.titleTierIndex is number && d.titleTierIndex >= 0 && d.titleTierIndex <= 7
        && d.updatedAt is number
        && d.updatedAt <= request.time.toMillis() + 300000
        && d.updatedAt >= request.time.toMillis() - 300000;
    }

    // Public mirror of just what an opponent row or a leaderboard row needs —
    // never the full private profile above. Readable by any signed-in user,
    // writable only by the account it describes.
    //
    // There is no server settling a duel's outcome (see the file header
    // above), so `weekXp`/`rating` are still ultimately self-reported — the
    // per-write delta caps below only bound *one write*. What actually closes
    // the gap is pairing that cap with a minimum real-time interval between
    // scoring writes: a genuine ranked duel takes well over a minute end to
    // end, so requiring 60 real seconds (by `request.time`, not anything the
    // client sends) between writes that change the score caps the achievable
    // rate to roughly one duel's worth of gain per minute, the same ceiling
    // actually playing imposes — instead of the unlimited rate an unthrottled
    // cap allowed (hundreds of scored "wins" in the time one real duel takes).
    // A pure identity refresh (`syncBattlePlayer`, which never touches
    // `weekXp`/`rating`) is exempt from the throttle, so it can still ping as
    // often as it likes.
    match /battlePlayers/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && validBattlePlayer(request.resource.data)
        && request.resource.data.weekXp is number
        && request.resource.data.weekXp >= 0 && request.resource.data.weekXp <= 600
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0 && request.resource.data.rating <= 20;
      allow update: if request.auth != null && request.auth.uid == uid
        && validBattlePlayer(request.resource.data)
        && request.resource.data.weekXp is number
        && request.resource.data.weekXp >= resource.data.weekXp
        && request.resource.data.weekXp <= resource.data.weekXp + 600
        && request.resource.data.rating is number
        && request.resource.data.rating <= resource.data.rating + 20
        && (
          (request.resource.data.weekXp == resource.data.weekXp
            && request.resource.data.rating == resource.data.rating)
          || request.time.toMillis() >= resource.data.updatedAt + 60000
        );
    }

    // One waiting slot per user, doc id = uid. Anyone signed in may scan the
    // queue to find a candidate — it carries no sensitive data. A slot may
    // only ever be cleared by the player it belongs to: `leaveQueue` is only
    // ever called with the caller's own uid (see `src/screens/BattleDuel.tsx`),
    // so nothing legitimate needs to delete anyone else's — and an open delete
    // let any signed-in user silently empty the whole queue.
    match /battleQueue/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.mode in ['casual', 'ranked'];
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // The atomic matchmaking lock, doc id = the uid of the player being
    // claimed. Created inside a transaction that first checks it is absent, so
    // two players can never claim the same candidate. `claimedBy` must be the
    // caller, and the candidate must genuinely be in the queue *right now* —
    // without that, a claim could be planted on any known uid at any time,
    // permanently jamming their matchmaking (every `claimCandidate`
    // transaction aborts while a claim already exists) even though they never
    // queued. `battleQueue/$(candidateUid)` is read from outside this write's
    // own transaction (it was written earlier, by the candidate's own
    // client), so this holds regardless of write order within a commit —
    // unlike cross-checking the match this claim names, which the same
    // transaction is creating in the same breath and so can't be leaned on
    // here without depending on same-transaction write visibility this rule
    // has no way to verify. `clearClaim` is only ever called with the
    // caller's own uid — the claim is the claimed player's own inbox — so
    // only they ever need to delete it.
    match /battleClaims/{candidateUid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.claimedBy
        && request.auth.uid != candidateUid
        && exists(/databases/$(database)/documents/battleQueue/$(candidateUid));
      allow delete: if request.auth != null && request.auth.uid == candidateUid;
    }

    // A live duel. Readable only by its two players. Created with two distinct
    // players and both slots genuinely empty — closing off a match seeded with
    // a pre-decided winner, or one that pairs a single account against itself
    // to farm both a win and a rating gain every round. On update the
    // immutable fields have to survive untouched, and each player may only
    // ever write their own slot: players[0] writes `p1`, players[1] writes
    // `p2` (either may flip `status`). Neither can reach into the other's
    // score.
    match /battleMatches/{matchId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.players;
      allow create: if request.auth != null
        && request.resource.data.players.size() == 2
        && request.auth.uid in request.resource.data.players
        && request.resource.data.players[0] != request.resource.data.players[1]
        && request.resource.data.status == 'active'
        && request.resource.data.p1.xp == 0 && request.resource.data.p2.xp == 0
        && request.resource.data.p1.doneAt == null && request.resource.data.p2.doneAt == null;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.players
        && request.resource.data.players == resource.data.players
        && request.resource.data.mode == resource.data.mode
        && request.resource.data.questionIds == resource.data.questionIds
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (request.auth.uid == resource.data.players[0] && request.resource.data.p2 == resource.data.p2)
          || (request.auth.uid == resource.data.players[1] && request.resource.data.p1 == resource.data.p1)
        );
    }

    /* ------------------------------- kahoot ------------------------------- */
    /*
     * The teacher-hosted live quiz (see src/lib/kahoot.ts). Same no-server
     * shape as the duels above: the teacher's own browser drives the room, and
     * the rules are what stop anyone else from driving it instead.
     */

    // An authored quiz. Deliberately *not* readable by students, not even the
    // ones in the teacher's own room: the correct answers are stored here, so
    // anyone who could read this collection could read the answer key straight
    // out of Firestore while the question is still open. Students never touch
    // it — the host copies each question's public half into the room document
    // below as it is revealed.
    // The query behind "my games" filters on `hostUid == uid`, which is what
    // lets the same condition serve `list` as well as `get`.
    match /kahootGames/{gameId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.hostUid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.hostUid;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.hostUid
        && request.resource.data.hostUid == resource.data.hostUid;
    }

    // A live room, doc id = the join code students type. Any signed-in user
    // may read it — that is how a student plays — but only the host ever
    // writes it, which is what makes `currentQuestion` trustworthy: a student
    // cannot plant a question, skip ahead, or reveal an answer early. The
    // answer to the open question is not in this document at all until the
    // host moves the room to `reveal`.
    match /kahootSessions/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.hostUid;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.hostUid;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.hostUid;

      // One row per student, keyed by uid so a student can only ever write
      // their own — never another player's score. `score` is self-reported
      // (there is no server to settle it against), but it can only ever move
      // up, and only by at most one question's worth at a time — the same
      // per-write delta shape `battlePlayers` uses. The identity fields
      // (`displayName`, `photoURL`) render to the whole class, so they are
      // shape-checked the same way the battle mirror's are — a client-side
      // sanitiser in `joinSession` is not a control against a hostile client.
      // `avatarTierIndex`/`titleTierIndex`: unbounded, a single crafted row
      // used to crash the lobby's leaderboard for the whole class the instant
      // it rendered.
      function validKahootPlayer(d) {
        return d.keys().hasOnly([
            'uid', 'displayName', 'photoURL', 'score', 'lastAnswerIndex',
            'lastAnswerAt', 'joinedAt', 'avatarGender', 'avatarTierIndex',
            'titleTierIndex',
          ])
          && d.displayName is string && d.displayName.size() <= 40
          && validSharedPhoto(d.photoURL)
          && d.avatarTierIndex is number
          && d.avatarTierIndex >= 0 && d.avatarTierIndex <= 7
          && d.titleTierIndex is number
          && d.titleTierIndex >= 0 && d.titleTierIndex <= 7;
      }
      match /players/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid
          && validKahootPlayer(request.resource.data)
          && request.resource.data.score is number && request.resource.data.score == 0;
        allow update: if request.auth != null && request.auth.uid == uid
          && validKahootPlayer(request.resource.data)
          && request.resource.data.score is number
          && request.resource.data.score >= resource.data.score
          && request.resource.data.score <= resource.data.score + 1200
          && request.resource.data.avatarTierIndex == resource.data.avatarTierIndex
          && request.resource.data.titleTierIndex == resource.data.titleTierIndex;
        allow delete: if request.auth != null && (
          request.auth.uid == uid
          || request.auth.uid == get(/databases/$(database)/documents/kahootSessions/$(code)).data.hostUid
        );
      }
    }

    /* ------------------------------ friends ------------------------------ */
    /*
     * Friends (see src/lib/friends.ts). Most of the people using this app are
     * children, so a friend can only be added by their personal code — never
     * found by name. Nothing below allows a `list` over anyone else's code or
     * friendships: a stranger cannot enumerate who uses the app, only look up
     * a code somebody chose to hand them. Same no-server shape as the duels:
     * each client only ever writes documents it is a party to.
     */

    // The 32-symbol alphabet `generateFriendCode` draws from: no I, O, 0 or 1,
    // the four characters a child reading a code off a friend's screen mixes up.
    function validFriendCodeId(code) {
      return code.matches('[A-HJ-NP-Z2-9]{8}');
    }

    // One personal code per account, for good. The code and its owner pointer
    // must land in the same batch (each checks the other with `getAfter`) and
    // neither can ever be updated or deleted — so an account cannot mint a
    // second code, and a `create` on a code that already exists is an update,
    // which is denied, so nobody can take over someone else's.
    match /friendCodes/{code} {
      // `get` only: looking a code up requires already knowing it.
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && validFriendCodeId(code)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is number
        && getAfter(/databases/$(database)/documents/friendCodeOwners/$(request.auth.uid)).data.code == code;
    }

    match /friendCodeOwners/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.code is string
        && getAfter(/databases/$(database)/documents/friendCodes/$(request.resource.data.code)).data.uid == uid;
    }

    // A request carries the code it was made with, and the rule checks that
    // code really belongs to the other person. That is what makes "only by
    // code" true: the uids on the public leaderboard are not enough on their
    // own to send anyone a request.
    function friendshipCodeMatches(d) {
      return (d.uids[0] == request.auth.uid
          && get(/databases/$(database)/documents/friendCodes/$(d.viaCode)).data.uid == d.uids[1])
        || (d.uids[1] == request.auth.uid
          && get(/databases/$(database)/documents/friendCodes/$(d.viaCode)).data.uid == d.uids[0]);
    }

    // One document per pair, id = the two uids sorted and joined with `_`
    // (Firebase uids never contain `_`). One document instead of a copy under
    // each user is what keeps this server-less: no client ever has to write
    // into another user's subtree.
    match /friendships/{pairId} {
      // A `get` is allowed on any pair id that names the caller — including
      // one that doesn't exist yet, which is how a client checks before
      // sending. Asking about someone else's pair is refused either way, so it
      // can't reveal whether two other people are friends.
      allow get: if request.auth != null && request.auth.uid in pairId.split('_');
      allow list: if request.auth != null && request.auth.uid in resource.data.uids;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uids', 'requestedBy', 'status', 'createdAt', 'viaCode'])
        && request.resource.data.uids is list
        && request.resource.data.uids.size() == 2
        && request.resource.data.uids[0] is string
        && request.resource.data.uids[1] is string
        && request.resource.data.uids[0] < request.resource.data.uids[1]
        && pairId == request.resource.data.uids[0] + '_' + request.resource.data.uids[1]
        && request.resource.data.requestedBy == request.auth.uid
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is number
        && request.resource.data.viaCode is string
        && friendshipCodeMatches(request.resource.data);
      // Only the person who was asked may answer, and the only answer that is
      // a write is "yes": pending → accepted, nothing else touched. "No" is a
      // delete, below.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.uids
        && request.auth.uid != resource.data.requestedBy
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt'])
        && request.resource.data.acceptedAt is number;
      // Decline, cancel and unfriend are all the same thing: either side
      // removes the pair.
      allow delete: if request.auth != null && request.auth.uid in resource.data.uids;
    }

    /* --------------------------- team battle ---------------------------- */
    /*
     * Gathering a team of 2–5 before a team battle (see src/lib/party.ts).
     * The 1v1 duel above is untouched — this is only for the bigger formats.
     *
     * A party's document id IS its join code, the same trick `kahootSessions`
     * uses: knowing the code is what lets someone in, so the code is what the
     * leader shares with friends. Every member writes the same document, so
     * the rules below have to say precisely which part of it each person owns:
     * the leader runs the party, and a member may only ever add or remove
     * *themselves*.
     */
    function validPartyCode(code) {
      return code.matches('[A-HJ-NP-Z2-9]{6}');
    }

    function validPartyShape(d) {
      return d.keys().hasOnly(['leader', 'members', 'mode', 'size', 'status', 'createdAt'])
        && d.leader is string
        && d.members is list && d.members.size() >= 1 && d.members.size() <= 5
        && d.leader in d.members
        && d.mode in ['casual', 'ranked']
        && d.size is int && d.size >= 2 && d.size <= 5
        && d.status in ['idle', 'queued']
        && d.createdAt is number;
    }

    /** Everything except `members` and `status` is the leader's to set, so a
     *  join or a leave must leave all of it exactly as it was. */
    function partyFramePreserved(next, prev) {
      return next.leader == prev.leader
        && next.mode == prev.mode
        && next.size == prev.size
        && next.createdAt == prev.createdAt;
    }

    match /parties/{code} {
      // Readable by any signed-in user: an invited friend has to be able to
      // look the code up before they are a member. The document holds uids and
      // a size, nothing personal — names come from `battlePlayers`.
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && validPartyCode(code)
        && validPartyShape(request.resource.data)
        && request.resource.data.leader == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.status == 'idle';
      allow update: if request.auth != null
        && validPartyShape(request.resource.data)
        && (
          // The leader runs the party: mode, size, status, and removing
          // someone. Never adding — nobody can be dragged into a party.
          (request.auth.uid == resource.data.leader
            && request.resource.data.leader == resource.data.leader
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.members.hasOnly(resource.data.members)
            && request.auth.uid in request.resource.data.members)
          // Joining: append yourself, change nothing else. Only into a party
          // that is still gathering, so nobody can slip into a live search.
          || (!(request.auth.uid in resource.data.members)
            && resource.data.status == 'idle'
            && request.resource.data.status == 'idle'
            && request.resource.data.members == resource.data.members.concat([request.auth.uid])
            && partyFramePreserved(request.resource.data, resource.data))
          // Leaving: remove yourself, change nothing else.
          || (request.auth.uid in resource.data.members
            && request.auth.uid != resource.data.leader
            && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
            && partyFramePreserved(request.resource.data, resource.data))
        );
      // Only the leader disbands it; a leaving member removes themselves above.
      allow delete: if request.auth != null && request.auth.uid == resource.data.leader;
    }

    // One queue slot per party, doc id = the party's code. Listable by any
    // signed-in user: that is how the format picker shows how many people are
    // waiting in each size, and how matchmaking finds an opponent party.
    // Written only by that party's leader, and only to match the party as it
    // actually stands — so a slot cannot claim a size the party doesn't have.
    match /partyQueue/{code} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['leader', 'size', 'mode', 'members', 'createdAt'])
        && request.resource.data.leader == request.auth.uid
        && request.resource.data.size is int
        && request.resource.data.size >= 2 && request.resource.data.size <= 5
        && request.resource.data.mode in ['casual', 'ranked']
        && request.resource.data.members is list
        && request.resource.data.members.size() == request.resource.data.size
        && request.resource.data.createdAt is number
        && get(/databases/$(database)/documents/parties/$(code)).data.leader == request.auth.uid
        && get(/databases/$(database)/documents/parties/$(code)).data.members == request.resource.data.members
        && get(/databases/$(database)/documents/parties/$(code)).data.size == request.resource.data.size;
      allow delete: if request.auth != null && request.auth.uid == resource.data.leader;
    }

    /* ------------------------------ ai usage ----------------------------- */
    /*
     * The daily cap on the shared Gemini key (see `api/gemini.ts`). The proxy
     * runs on Vercel with no Firebase Admin credentials by default, so it
     * cannot hold a privileged write — it increments these counters with the
     * *caller's own* ID token. That is only safe because the rules here make
     * the counter tamper-evident: it may be created at 1, may only ever go up
     * by exactly 1, and can never be deleted or reset. A user who spends their
     * 50 for the day cannot zero it back out.
     *
     * `bucket` is the uid for a per-user counter, or the literal `_shared` for
     * the global circuit-breaker. `day` is `YYYY-MM-DD`. Both writes must carry
     * exactly `{ count, day }` and nothing else.
     */
    match /aiUsage/{bucket}/days/{day} {
      // Per-user counter — only its owner ever sees or moves it.
      allow read: if request.auth != null && request.auth.uid == bucket;
      allow create: if request.auth != null && request.auth.uid == bucket
        && request.resource.data.keys().hasOnly(['count', 'day'])
        && request.resource.data.count == 1
        && request.resource.data.day == day;
      allow update: if request.auth != null && request.auth.uid == bucket
        && request.resource.data.keys().hasOnly(['count', 'day'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.day == resource.data.day;

      // Global circuit-breaker (`bucket == '_shared'`): any signed-in caller
      // may push it up by one; nobody can pull it down. Worst case a malicious
      // client inflates it and trips the day's global ceiling early — a mild
      // griefing trade for metering a shared API key with no service account
      // at all.
      allow read: if request.auth != null && bucket == '_shared';
      allow create: if request.auth != null && bucket == '_shared'
        && request.resource.data.keys().hasOnly(['count', 'day'])
        && request.resource.data.count == 1
        && request.resource.data.day == day;
      allow update: if request.auth != null && bucket == '_shared'
        && request.resource.data.keys().hasOnly(['count', 'day'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.day == resource.data.day;
    }

    // Firestore already denies anything no `allow` matches; this states that
    // intent in the file. (It is not a backstop against a too-broad `allow`
    // elsewhere — `allow` clauses union, so a later mistake still has to be
    // caught in review, not here.)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
