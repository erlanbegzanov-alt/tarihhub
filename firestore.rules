rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The only document path the app reads/writes: each signed-in user's own
    // progress state. Scoped to `request.auth.uid == uid` — one user can
    // never read or write another user's document.
    match /users/{uid}/profile/state {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Explicit deny-all default: blocks any other path, including ones added
    // by mistake later, from being reachable without an matching rule above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
