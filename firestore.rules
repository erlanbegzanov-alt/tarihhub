rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    /* ------------------------------ profile ------------------------------ */

    // The shape and bounds of one progress document. There is no server to
    // award XP, so the client holds the write credential for its own profile —
    // but "my own document" is not the same as "any bytes I like". Without the
    // checks below a signed-in user could `setDoc` `xp: 1e9` (or roll a
    // lifetime counter *back* to re-earn a one-time reward) straight past the
    // clamps in `src/lib/progress.ts`, which only run client-side.
    //
    // `progressCountersMonotonic` is applied on update only: every field that
    // is a lifetime total in `progress.ts` (never decreased on any legit path —
    // `Math.max` on merge, `+1`/`+xp` on write) may only stay equal or grow.
    // Streaks are deliberately absent from it: they reset to 0/1 by design.
    function validProfileShape(d) {
      return d.keys().hasOnly([
          'xp', 'streak', 'quizzesCompleted', 'unlockedBadges', 'totalVisits',
          'lastVisitDate', 'dailyDate', 'dailyStreak',
          'peopleViewed', 'timelineViewed', 'lessonProgress',
          'completedLessons', 'lessonQuizBest', 'sectionChecksDone',
          'avatarGender', 'displayedRankTier', 'displayedAvatarTier',
          'casualDuels', 'casualWins', 'casualStreak', 'recentCasualDuels',
          'rankedDuels', 'rankedWins', 'rankedStreak', 'recentRankedDuels',
        ])
        && d.xp is number && d.xp >= 0 && d.xp <= 10000000
        && d.streak is number && d.streak >= 0 && d.streak <= 100000
        && d.quizzesCompleted is number && d.quizzesCompleted >= 0 && d.quizzesCompleted <= 1000000
        && d.totalVisits is number && d.totalVisits >= 0 && d.totalVisits <= 1000000
        && d.casualDuels is number && d.casualDuels >= 0 && d.casualDuels <= 1000000
        && d.casualWins is number && d.casualWins >= 0 && d.casualWins <= 1000000
        && d.casualStreak is number && d.casualStreak >= 0 && d.casualStreak <= 100000
        && d.rankedDuels is number && d.rankedDuels >= 0 && d.rankedDuels <= 1000000
        && d.rankedWins is number && d.rankedWins >= 0 && d.rankedWins <= 1000000
        && d.rankedStreak is number && d.rankedStreak >= 0 && d.rankedStreak <= 100000
        && d.lastVisitDate is string && d.lastVisitDate.size() <= 10
        // Read through `get` with a default rather than asserted directly: a
        // client still running a build from before the daily set exists writes
        // a document with neither field, and `d.dailyDate is string` would
        // reject that whole document — the same stale-build failure that made
        // every party write fail on 2026-09-28. Absent is a valid old shape.
        && d.get('dailyDate', '') is string && d.get('dailyDate', '').size() <= 10
        && d.get('dailyStreak', 0) is number
        && d.get('dailyStreak', 0) >= 0 && d.get('dailyStreak', 0) <= 100000
        && d.timelineViewed is bool
        && d.unlockedBadges is list && d.unlockedBadges.size() <= 200
        && d.peopleViewed is list && d.peopleViewed.size() <= 5000
        && d.completedLessons is list && d.completedLessons.size() <= 2000
        && d.sectionChecksDone is list && d.sectionChecksDone.size() <= 20000
        && d.recentCasualDuels is list && d.recentCasualDuels.size() <= 8
        && d.recentRankedDuels is list && d.recentRankedDuels.size() <= 10
        && d.lessonProgress is map && d.lessonProgress.size() <= 2000
        && d.lessonQuizBest is map && d.lessonQuizBest.size() <= 2000
        && (d.avatarGender == null || d.avatarGender in ['m', 'f'])
        && (d.displayedRankTier == null
            || (d.displayedRankTier is int && d.displayedRankTier >= 0 && d.displayedRankTier <= 20))
        && (d.displayedAvatarTier == null
            || (d.displayedAvatarTier is int && d.displayedAvatarTier >= 0 && d.displayedAvatarTier <= 20));
    }

    // `prev` is the *stored* doc, only ever as complete as the client that last
    // wrote it — and `casualDuels`/`rankedWins` etc. are younger than the
    // cloud mirror itself, so a doc last written in Aug 2026 can be missing
    // them. Reading an absent map key is an evaluation error (which denies), so
    // every stored-side read goes through `.get(key, 0)`: a field the doc never
    // had reads as 0, and any new value is trivially "not a rollback".
    // Append-only collections get the same treatment by size.
    function progressCountersMonotonic(next, prev) {
      return next.xp >= prev.get('xp', 0) && next.xp <= prev.get('xp', 0) + 100000
        && next.quizzesCompleted >= prev.get('quizzesCompleted', 0)
        && next.totalVisits >= prev.get('totalVisits', 0)
        && next.casualDuels >= prev.get('casualDuels', 0)
        && next.casualWins >= prev.get('casualWins', 0)
        && next.rankedDuels >= prev.get('rankedDuels', 0)
        && next.rankedWins >= prev.get('rankedWins', 0)
        && next.completedLessons.size() >= prev.get('completedLessons', []).size()
        && next.unlockedBadges.size() >= prev.get('unlockedBadges', []).size()
        && next.peopleViewed.size() >= prev.get('peopleViewed', []).size()
        && next.sectionChecksDone.size() >= prev.get('sectionChecksDone', []).size()
        && (next.timelineViewed || !prev.get('timelineViewed', false));
    }

    // Scoped to `request.auth.uid == uid` — one user can never read or touch
    // another user's document.
    match /users/{uid}/profile/state {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && validProfileShape(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
        && validProfileShape(request.resource.data)
        && progressCountersMonotonic(request.resource.data, resource.data);
      allow delete: if false;
    }

    /* ------------------------------ battles ------------------------------ */
    /*
     * The 1v1 battle mode (see src/lib/battle.ts) is the only part of the app
     * where one signed-in user sees anything belonging to another. Every
     * collection below is shaped so that no client ever needs write permission
     * on a document another user owns: a player only ever writes their own
     * mirror, their own queue slot, and their own half of a shared match.
     */

    // Shared shape check for `battlePlayers/{uid}`: every field a client can
    // set on its own mirror, other than the scored ones (`weekXp`, `rating`),
    // which each allow-clause bounds separately since create and update cap
    // them differently. `avatarTierIndex`/`titleTierIndex` top out at
    // `ranks.length` (7, see src/lib/rankStyle.ts's `OWNER_TIER_INDEX`) — an
    // out-of-range value used to be able to reach this collection and crash
    // `RankBadge`/`rankTitleText` for every viewer of the leaderboard, since
    // those only clamped the *lower* bound. `updatedAt` has to stay near the
    // server's own clock (not just be *a* number) for the write-rate check
    // below to mean anything — a client that could freely backdate it could
    // otherwise reopen the throttle on every write. The tolerance is ±5
    // minutes, not ±5 seconds: real devices routinely run tens of seconds off
    // NTP, and a ±5s window was silently denying every `syncBattlePlayer`
    // write (and so every duel) for those users. ±5min still pins the value
    // close enough that the 60s scoring throttle keeps its intent.
    // Empty, or an https URL on the one host a shared identity photo ever comes
    // from (a Google account image). Reused by the Кахут player row below.
    // The owner tier, index 7, sits one past the seven-rung ladder in
    // src/data/ranks.ts. It is granted by identity and cannot be earned by
    // any amount of XP — src/lib/rankStyle.ts says exactly that and checks
    // the signed-in session for it. These rules did not: both public mirrors
    // bounded the index at 0..7 and stopped there, so any signed-in user
    // could write 7 to their own row and be rendered to every other viewer —
    // the weekly board, a duel opponent card, every student in a Кахут room —
    // with the gold ring and the "Разработчик" title. That is convincing
    // impersonation of the developer in front of classmates, most of them
    // minors.
    //
    // The verified flag is required as well as the address: an ID token
    // whose email claim was never verified must not stand in for it.
    function ownerTierMax() {
      // Read through get() with a default, never as a bare field. A token
      // without an email claim — which is most of them — makes
      // request.auth.token.email an error, not a null, and an error denies
      // the whole write. That is the same missing-key trap this file already
      // documents for document fields, and it bit here first: two unrelated
      // battlePlayers tests went red the moment the bare form went in.
      return request.auth.token.get('email', '') == 'erlanbegzanov@gmail.com'
        && request.auth.token.get('email_verified', false) == true
        ? 7 : 6;
    }

    function validSharedPhoto(url) {
      return url is string && url.size() <= 300
        && (url == '' || url.matches('https://lh3[.]googleusercontent[.]com(/.*)?'));
    }

    // The millisecond this row's score last actually moved, read out of the
    // *stored* document. New writes stamp it with `serverTimestamp()` (see
    // `applyRankedResult`), rows written before that change still carry a plain
    // number, and a row that has never scored carries `0` — or, if it was
    // written before the field existed, nothing at all. All three read as "long
    // ago", which is the right answer for a throttle anchor.
    function lastScoredMillis(d) {
      let anchor = d.get('scoredAt', 0);
      return anchor is timestamp ? anchor.toMillis() : (anchor is number ? anchor : 0);
    }

    // The week the stored row belongs to, as a plain `YYYY-MM-DD` string.
    // Guarded because the reset branch below *compares* it: a row carrying
    // something that is not a string would otherwise make the whole rule error
    // out (and so deny) rather than simply start a new week.
    function storedWeek(d) {
      let week = d.get('weekStart', '');
      return week is string ? week : '';
    }

    function validBattlePlayer(d) {
      return d.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'level', 'rating', 'weekXp',
          'weekStart', 'updatedAt', 'scoredAt', 'avatarGender',
          'avatarTierIndex', 'titleTierIndex',
        ])
        && d.displayName is string && d.displayName.size() <= 40
        // Every viewer of the weekly board fetches this as an <img src>. A
        // player photo is only ever the signed-in user's Google account image,
        // so the allow-list is exactly that one host — not the whole of
        // `res.cloudinary.com` (a shared multi-tenant CDN where any free
        // account could plant a tracking URL that still parses). Mirrors
        // `safePhotoURL` in `src/lib/safeUrl.ts`; Кахут question photos are a
        // different, host-authored field.
        && validSharedPhoto(d.photoURL)
        && d.level is number && d.level >= 1 && d.level <= 500
        && d.avatarTierIndex is number
        && d.avatarTierIndex >= 0 && d.avatarTierIndex <= ownerTierMax()
        && d.titleTierIndex is number
        && d.titleTierIndex >= 0 && d.titleTierIndex <= ownerTierMax()
        && d.weekStart is string && d.weekStart.size() <= 10
        && d.updatedAt is number
        && d.updatedAt <= request.time.toMillis() + 300000
        && d.updatedAt >= request.time.toMillis() - 300000;
    }

    // Public mirror of just what an opponent row or a leaderboard row needs —
    // never the full private profile above. Readable by any signed-in user,
    // writable only by the account it describes.
    //
    // There is no server settling a duel's outcome (see the file header
    // above), so `weekXp`/`rating` are still ultimately self-reported — the
    // per-write delta caps below only bound *one write*. What actually closes
    // the gap is pairing that cap with a minimum real-time interval between
    // scoring writes: a genuine ranked duel takes well over a minute end to
    // end, so requiring 60 real seconds (by `request.time`, not anything the
    // client sends) between writes that change the score caps the achievable
    // rate to roughly one duel's worth of gain per minute, the same ceiling
    // actually playing imposes — instead of the unlimited rate an unthrottled
    // cap allowed (hundreds of scored "wins" in the time one real duel takes).
    // A pure identity refresh (`syncBattlePlayer`, which never touches
    // `weekXp`/`rating`) is exempt from the throttle, so it can still ping as
    // often as it likes.
    match /battlePlayers/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && validBattlePlayer(request.resource.data)
        && request.resource.data.weekXp is number
        && request.resource.data.weekXp >= 0 && request.resource.data.weekXp <= 600
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0 && request.resource.data.rating <= 20
        // Either the zeroed baseline `syncBattlePlayer` writes for a player
        // seen for the first time, or a real server-stamped scoring write that
        // happens to be this row's first. Nothing in between: a create free to
        // name its own anchor would start life with the throttle below already
        // cleared. Both sides are type-guarded, so a number is never compared
        // against a timestamp.
        && (
          (request.resource.data.scoredAt is number && request.resource.data.scoredAt == 0)
          || (request.resource.data.scoredAt is timestamp
            && request.resource.data.scoredAt == request.time)
        );
      allow update: if request.auth != null && request.auth.uid == uid
        && validBattlePlayer(request.resource.data)
        && request.resource.data.weekXp is number
        && request.resource.data.weekXp >= 0
        // An absolute ceiling, not only a per-write delta. `MAX_BATTLE_XP` is
        // 594, so 36000 is sixty duels inside one week — four a day, ten times
        // what the busiest real account does. Without it, a slow drip of
        // individually legal writes reached any number at all, and the only
        // thing between a scripted drip and the top of the board was the
        // interval below.
        && request.resource.data.weekXp <= 36000
        && request.resource.data.rating is number
        // Both directions now. The upper bound was always here (`RATING_WIN`
        // is 18). The lower one is new, and it is what stops one write erasing
        // a ladder built over months — the exact shape the lazy weekly reset
        // produced by accident whenever a *failed* read looked like a missing
        // row and the client wrote a zeroed baseline over a real rating.
        // `RATING_LOSS` is 9 and the rating floors at zero, so 20 is slack.
        && request.resource.data.rating >= resource.data.rating - 20
        && request.resource.data.rating <= resource.data.rating + 20
        && request.resource.data.rating <= 5000
        && (
          // Inside one week the total only ever climbs, by at most one duel's
          // worth per write.
          (request.resource.data.weekStart == storedWeek(resource.data)
            && request.resource.data.weekXp >= resource.data.weekXp
            && request.resource.data.weekXp <= resource.data.weekXp + 600)
          // A new week starts over, which is why `weekXp` is not simply
          // monotonic: `normalizeBattlePlayer` reads a stale row as zero, so
          // the first duel of a Monday legitimately writes a *smaller* number
          // than the one stored. The monotonic rule refused that write — and
          // because the rating gain travelled in the same `setDoc`, the
          // player's win was thrown away with it, every Monday, in silence.
          // Any *different* week, not only a later one. `>` reads as the
          // tighter rule and is the wrong one: `isoWeekStart` comes off the
          // device's own clock, so a phone set a month ahead stores a week in
          // the future, and once its owner fixes the clock every duel result
          // they ever earn would be refused, forever. Nothing is gained by
          // flipping the week either — this path can only ever *lower* the
          // weekly total, which costs its author their place on the board.
          || (request.resource.data.weekStart != storedWeek(resource.data)
            && request.resource.data.weekXp <= 600)
        )
        && (
          // Nothing was gained: an identity refresh (`syncBattlePlayer`, which
          // never mentions these fields) or a bare weekly reset. The anchor has
          // to survive untouched, or either could be used to clear the throttle.
          (request.resource.data.rating <= resource.data.rating
            && request.resource.data.weekXp <= resource.data.weekXp
            && request.resource.data.scoredAt == resource.data.scoredAt)
          // Something was gained, so this write carries a duel's outcome and the
          // throttle applies. The anchor is stamped by the *server* —
          // `request.time`, which no client can backdate and no drifting phone
          // clock can break — and the previous one has to be a full minute old.
          //
          // This used to anchor on `updatedAt`, which the same ruleset lets a
          // client set five minutes in the past (300000 against a 60000
          // threshold), so the interval was void: one backdated write opened the
          // next, and eleven landed in a row with no wait at all. The field that
          // was *meant* to be the anchor, `scoredAt`, was written by the client,
          // listed among the allowed keys, and read by no rule at all.
          || (request.resource.data.scoredAt is timestamp
            && request.resource.data.scoredAt == request.time
            && request.time.toMillis() >= lastScoredMillis(resource.data) + 60000)
        );
    }

    // One waiting slot per user, doc id = uid. Anyone signed in may scan the
    // queue to find a candidate — it carries no sensitive data. A slot may
    // only ever be cleared by the player it belongs to: `leaveQueue` is only
    // ever called with the caller's own uid (see `src/screens/BattleDuel.tsx`),
    // so nothing legitimate needs to delete anyone else's — and an open delete
    // let any signed-in user silently empty the whole queue.
    match /battleQueue/{uid} {
      allow read: if request.auth != null;
      // Every other collection here pins its shape; these two did not, so a
      // caller could hang an arbitrary payload off their own queue slot — and
      // this document is read by every other player sweeping for a match, so
      // the bloat is billed to everyone searching, not just to its author.
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'mode', 'joinedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.mode in ['casual', 'ranked'];
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // The atomic matchmaking lock, doc id = the uid of the player being
    // claimed. Created inside a transaction that first checks it is absent, so
    // two players can never claim the same candidate. `claimedBy` must be the
    // caller, and the candidate must genuinely be in the queue *right now* —
    // without that, a claim could be planted on any known uid at any time,
    // permanently jamming their matchmaking (every `claimCandidate`
    // transaction aborts while a claim already exists) even though they never
    // queued. `battleQueue/$(candidateUid)` is read from outside this write's
    // own transaction (it was written earlier, by the candidate's own
    // client), so this holds regardless of write order within a commit —
    // unlike cross-checking the match this claim names, which the same
    // transaction is creating in the same breath and so can't be leaned on
    // here without depending on same-transaction write visibility this rule
    // has no way to verify. `clearClaim` is only ever called with the
    // caller's own uid — the claim is the claimed player's own inbox — so
    // only they ever need to delete it.
    match /battleClaims/{candidateUid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['claimedBy', 'matchId', 'createdAt'])
        && request.auth.uid == request.resource.data.claimedBy
        && request.auth.uid != candidateUid
        && exists(/databases/$(database)/documents/battleQueue/$(candidateUid));
      allow delete: if request.auth != null && request.auth.uid == candidateUid;
    }

    // A live duel. Readable only by its two players. Created with two distinct
    // players and both slots genuinely empty — closing off a match seeded with
    // a pre-decided winner, or one that pairs a single account against itself
    // to farm both a win and a rating gain every round. On update the
    // immutable fields have to survive untouched, and each player may only
    // ever write their own slot: players[0] writes `p1`, players[1] writes
    // `p2` (either may flip `status`). Neither can reach into the other's
    // score.
    match /battleMatches/{matchId} {
      // One player's half of a live duel. Both halves are read by both clients
      // on every write either of them makes, so an unbounded `answers` here is
      // billed to the opponent as much as to its author — which is why the list
      // is bounded even though nothing reads past `questionIds`.
      function validSlot(s, questions) {
        return s.keys().hasOnly(['answers', 'xp', 'doneAt', 'lastSeenAt'])
          && s.answers is list
          && s.answers.size() >= questions && s.answers.size() <= 30
          && s.xp is number && s.xp >= 0 && s.xp <= 600
          && s.lastSeenAt is number;
      }

      allow read: if request.auth != null && request.auth.uid in resource.data.players;
      // This rule had no test of its own and barely any conditions: two
      // players, a status, and both slots empty. Everything else about the
      // document — its keys, its types, how old it claims to be — went
      // unchecked, so a hand-written match could name any shape it liked and
      // carry a `createdAt` from last year, which is what let a forged duel be
      // planted on someone who was only looking for an opponent.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
            'mode', 'players', 'questionIds', 'p1', 'p2', 'createdAt', 'status',
          ])
        && request.resource.data.players is list
        && request.resource.data.players.size() == 2
        && request.auth.uid in request.resource.data.players
        && request.resource.data.players[0] is string
        && request.resource.data.players[1] is string
        && request.resource.data.players[0] != request.resource.data.players[1]
        && request.resource.data.mode in ['casual', 'ranked']
        && request.resource.data.questionIds is list
        && request.resource.data.questionIds.size() >= 1
        // `pickRoundQuestionIds` returns ROUND_SIZE (3) ids from each of three
        // pools, so nine is the honest figure and fewer is possible when a pool
        // runs short. Thirty is the bound, not the expectation.
        && request.resource.data.questionIds.size() <= 30
        && request.resource.data.status == 'active'
        // Same five minutes each way the rest of this file allows a client
        // clock. A duel is opened and played within minutes, so a match that
        // claims to be older than that is not one anybody is about to play —
        // and staleness is exactly what a planted match needs to survive until
        // its victim stumbles into it.
        && request.resource.data.createdAt is number
        && request.resource.data.createdAt >= request.time.toMillis() - 300000
        && request.resource.data.createdAt <= request.time.toMillis() + 300000
        && validSlot(request.resource.data.p1, request.resource.data.questionIds.size())
        && validSlot(request.resource.data.p2, request.resource.data.questionIds.size())
        && request.resource.data.p1.xp == 0 && request.resource.data.p2.xp == 0
        && request.resource.data.p1.doneAt == null && request.resource.data.p2.doneAt == null;
      // A slot score is NOT cosmetic: the client reads its own slot back out
      // of this document and hands it straight to `recordBattleResult`, which
      // adds it to the real profile XP, and compares it against the other slot
      // to decide a ranked win. Create pins both slots to 0 but update used to
      // bound neither, so one `updateDoc` writing `p1.xp: 99999` — no
      // questions answered — both inflated lifetime XP and forced a win.
      // 600 is the honest ceiling with a little room: `MAX_BATTLE_XP` in
      // src/lib/battle.ts is BATTLE_QUESTIONS 9 x (XP_PER_CORRECT 30 +
      // QUESTION_SECONDS 12 x XP_PER_SECOND_LEFT 3) = 594.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.players
        && validSlot(request.resource.data.p1, resource.data.questionIds.size())
        && validSlot(request.resource.data.p2, resource.data.questionIds.size())
        && request.resource.data.players == resource.data.players
        && request.resource.data.mode == resource.data.mode
        && request.resource.data.questionIds == resource.data.questionIds
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (request.auth.uid == resource.data.players[0] && request.resource.data.p2 == resource.data.p2)
          || (request.auth.uid == resource.data.players[1] && request.resource.data.p1 == resource.data.p1)
        );
    }

    /* ------------------------------- kahoot ------------------------------- */
    /*
     * The teacher-hosted live quiz (see src/lib/kahoot.ts). Same no-server
     * shape as the duels above: the teacher's own browser drives the room, and
     * the rules are what stop anyone else from driving it instead.
     */

    // An authored quiz. Deliberately *not* readable by students, not even the
    // ones in the teacher's own room: the correct answers are stored here, so
    // anyone who could read this collection could read the answer key straight
    // out of Firestore while the question is still open. Students never touch
    // it — the host copies each question's public half into the room document
    // below as it is revealed.
    // The query behind "my games" filters on `hostUid == uid`, which is what
    // lets the same condition serve `list` as well as `get`.
    match /kahootGames/{gameId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.hostUid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.hostUid;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.hostUid
        && request.resource.data.hostUid == resource.data.hostUid;
    }

    // A live room, doc id = the join code students type. Any signed-in user
    // may read it — that is how a student plays — but only the host ever
    // writes it, which is what makes `currentQuestion` trustworthy: a student
    // cannot plant a question, skip ahead, or reveal an answer early. The
    // answer to the open question is not in this document at all until the
    // host moves the room to `reveal`.
    match /kahootSessions/{code} {
      // `get`, deliberately not `read`: `read` is get plus list, and a list over
      // this collection hands back every live room code in the school at once —
      // after which the players subcollection below gives up each room's names
      // and scores. A student needs to fetch exactly the one code they were
      // told, which is what `get` is. `parties` already does it this way.
      // Nothing in the app queries this collection: the host's own "my games"
      // list is a query over `kahootGames`, and a code is checked for being
      // free with a single `getDoc` (`codeIsFree` in src/lib/kahoot.ts).
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.hostUid;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.hostUid;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.hostUid;

      // One row per student, keyed by uid so a student can only ever write
      // their own — never another player's score. `score` is self-reported
      // (there is no server to settle it against), but it can only ever move
      // up, and only by at most one question's worth at a time — the same
      // per-write delta shape `battlePlayers` uses. The identity fields
      // (`displayName`, `photoURL`) render to the whole class, so they are
      // shape-checked the same way the battle mirror's are — a client-side
      // sanitiser in `joinSession` is not a control against a hostile client.
      // `avatarTierIndex`/`titleTierIndex`: unbounded, a single crafted row
      // used to crash the lobby's leaderboard for the whole class the instant
      // it rendered.
      //
      // `lastAnswerIndex`, `lastAnswerAt` and `joinedAt` sat in the key list
      // and were never typed. The readers in `kahoot.ts` coerce them, so
      // nothing crashed, but two of them decide what the class sees:
      // `lastAnswerAt` is what `answeredThisRound` compares against the
      // question's start, so a far-future value showed a student as having
      // answered every question without answering any; and `joinedAt` is the
      // leaderboard's tie-break, so `0` won every tie forever. Bounding them
      // does not make either timestamp trustworthy — both are the client's own
      // clock — it only stops the absurd values.
      function validKahootPlayer(d) {
        return d.keys().hasOnly([
            'uid', 'displayName', 'photoURL', 'score', 'lastAnswerIndex',
            'lastAnswerAt', 'joinedAt', 'avatarGender', 'avatarTierIndex',
            'titleTierIndex',
          ])
          && d.displayName is string && d.displayName.size() <= 40
          && validSharedPhoto(d.photoURL)
          // null until the first answer; otherwise one of the four options.
          // `KAHOOT_OPTIONS` is 4 and fixed, like the duel's.
          && (d.lastAnswerIndex == null
            || (d.lastAnswerIndex is int
              && d.lastAnswerIndex >= 0 && d.lastAnswerIndex <= 3))
          // No lower bound beyond zero: on a write that does not touch it, the
          // merged document still carries the previous answer's time, which is
          // legitimately minutes old. Only the future is a lie.
          && (d.lastAnswerAt == null
            || (d.lastAnswerAt is number && d.lastAnswerAt >= 0
              && d.lastAnswerAt <= request.time.toMillis() + 300000))
          && d.joinedAt is number && d.joinedAt > 0
          && d.avatarTierIndex is number
          && d.avatarTierIndex >= 0 && d.avatarTierIndex <= ownerTierMax()
          && d.titleTierIndex is number
          && d.titleTierIndex >= 0 && d.titleTierIndex <= ownerTierMax();
      }
      match /players/{uid} {
        // Five minutes each way: every one of these timestamps is a client's
        // `Date.now()`, and a school Android with a drifting clock is an
        // honest player, not an attacker.
        function joinedNow(v) {
          return v >= request.time.toMillis() - 300000
            && v <= request.time.toMillis() + 300000;
        }
        // The room's own question counter, or -1 when the room is gone.
        function roomIndex() {
          return exists(/databases/$(database)/documents/kahootSessions/$(code))
            ? get(/databases/$(database)/documents/kahootSessions/$(code)).data.get('questionIndex', 0)
            : -1;
        }
        // How many questions the host has opened, counting the one on screen.
        // `questionIndex` lives in the room document, which only the host may
        // write — so it is the one count in a live game a student cannot move,
        // and therefore the only honest ceiling a self-reported running total
        // can be held to.
        function questionsOpened() {
          let index = roomIndex();
          return index is number && index >= 0 ? index + 1 : 0;
        }
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid
          && validKahootPlayer(request.resource.data)
          && joinedNow(request.resource.data.joinedAt)
          && request.resource.data.score is number && request.resource.data.score == 0;
        allow update: if request.auth != null && request.auth.uid == uid
          && validKahootPlayer(request.resource.data)
          // Unchanged on an answer; re-stamped when a student reloads in the
          // lobby, which rewrites the whole row through `joinSession`. Both
          // are honest, and `0` is neither.
          && (request.resource.data.joinedAt == resource.data.joinedAt
            || joinedNow(request.resource.data.joinedAt))
          && request.resource.data.score is number
          && request.resource.data.score >= resource.data.score
          // One question's honest maximum is 66, not 90: `KahootJoin` calls
          // `answerXp` without a clock argument, so the speed bonus is clamped
          // at the duel's `QUESTION_SECONDS` (12 x `XP_PER_SECOND_LEFT` 3)
          // rather than stretched over the room's twenty — which is what the
          // comment on `KAHOOT_QUESTION_SECONDS` says, and what the code does.
          // 70 leaves the same little room the other ceilings leave.
          //
          // The delta alone was never enough, and 1200 made it meaningless: a
          // cap on one write is only a cap on the rate at which someone writes.
          // The second bound is the one that closes it — a total can never
          // exceed one question's worth for every question the *host* has
          // opened, however many writes it took to get there.
          && request.resource.data.score <= resource.data.score + 70
          && request.resource.data.score <= 70 * questionsOpened()
          && request.resource.data.avatarTierIndex == resource.data.avatarTierIndex
          && request.resource.data.titleTierIndex == resource.data.titleTierIndex;
        allow delete: if request.auth != null && (
          request.auth.uid == uid
          || request.auth.uid == get(/databases/$(database)/documents/kahootSessions/$(code)).data.hostUid
        );
      }
    }

    /* ------------------------------ friends ------------------------------ */
    /*
     * Friends (see src/lib/friends.ts). Most of the people using this app are
     * children, so a friend can only be added by their personal code — never
     * found by name. Nothing below allows a `list` over anyone else's code or
     * friendships: a stranger cannot enumerate who uses the app, only look up
     * a code somebody chose to hand them. Same no-server shape as the duels:
     * each client only ever writes documents it is a party to.
     */

    // The 32-symbol alphabet `generateFriendCode` draws from: no I, O, 0 or 1,
    // the four characters a child reading a code off a friend's screen mixes up.
    function validFriendCodeId(code) {
      return code.matches('[A-HJ-NP-Z2-9]{8}');
    }

    // One personal code per account, for good. The code and its owner pointer
    // must land in the same batch (each checks the other with `getAfter`) and
    // neither can ever be updated or deleted — so an account cannot mint a
    // second code, and a `create` on a code that already exists is an update,
    // which is denied, so nobody can take over someone else's.
    match /friendCodes/{code} {
      // `get` only: looking a code up requires already knowing it.
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && validFriendCodeId(code)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is number
        && getAfter(/databases/$(database)/documents/friendCodeOwners/$(request.auth.uid)).data.code == code;
    }

    match /friendCodeOwners/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.code is string
        && getAfter(/databases/$(database)/documents/friendCodes/$(request.resource.data.code)).data.uid == uid;
    }

    // A request carries the code it was made with, and the rule checks that
    // code really belongs to the other person. That is what makes "only by
    // code" true: the uids on the public leaderboard are not enough on their
    // own to send anyone a request.
    function friendshipCodeMatches(d) {
      return (d.uids[0] == request.auth.uid
          && get(/databases/$(database)/documents/friendCodes/$(d.viaCode)).data.uid == d.uids[1])
        || (d.uids[1] == request.auth.uid
          && get(/databases/$(database)/documents/friendCodes/$(d.viaCode)).data.uid == d.uids[0]);
    }

    // One document per pair, id = the two uids sorted and joined with `_`
    // (Firebase uids never contain `_`). One document instead of a copy under
    // each user is what keeps this server-less: no client ever has to write
    // into another user's subtree.
    match /friendships/{pairId} {
      // A `get` is allowed on any pair id that names the caller — including
      // one that doesn't exist yet, which is how a client checks before
      // sending. Asking about someone else's pair is refused either way, so it
      // can't reveal whether two other people are friends.
      allow get: if request.auth != null && request.auth.uid in pairId.split('_');
      allow list: if request.auth != null && request.auth.uid in resource.data.uids;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uids', 'requestedBy', 'status', 'createdAt', 'viaCode'])
        && request.resource.data.uids is list
        && request.resource.data.uids.size() == 2
        && request.resource.data.uids[0] is string
        && request.resource.data.uids[1] is string
        && request.resource.data.uids[0] < request.resource.data.uids[1]
        && pairId == request.resource.data.uids[0] + '_' + request.resource.data.uids[1]
        && request.resource.data.requestedBy == request.auth.uid
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is number
        && request.resource.data.viaCode is string
        && friendshipCodeMatches(request.resource.data);
      // Only the person who was asked may answer, and the only answer that is
      // a write is "yes": pending → accepted, nothing else touched. "No" is a
      // delete, below.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.uids
        && request.auth.uid != resource.data.requestedBy
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt'])
        && request.resource.data.acceptedAt is number;
      // Decline, cancel and unfriend are all the same thing: either side
      // removes the pair.
      allow delete: if request.auth != null && request.auth.uid in resource.data.uids;
    }

    /* --------------------------- team battle ---------------------------- */
    /*
     * Gathering a team of 2–5 before a team battle (see src/lib/party.ts).
     * The 1v1 duel above is untouched — this is only for the bigger formats.
     *
     * A party's document id IS its join code, the same trick `kahootSessions`
     * uses: knowing the code is what lets someone in, so the code is what the
     * leader shares with friends. Every member writes the same document, so
     * the rules below have to say precisely which part of it each person owns:
     * the leader runs the party, and a member may only ever add or remove
     * *themselves*.
     */
    function validPartyCode(code) {
      return code.matches('[A-HJ-NP-Z2-9]{6}');
    }

    // A room holds BOTH sides now, so it is twice a team: up to ten people.
    // `teams` must account for exactly the members present — a side listing
    // someone who is not in the room could start a match with a ghost, and a
    // member on neither side could never be picked to play.
    function validPartyShape(d) {
      return d.keys().hasOnly(['leader', 'members', 'mode', 'size', 'status', 'createdAt', 'teams'])
        && d.leader is string
        && d.members is list && d.members.size() >= 1 && d.members.size() <= 10
        && d.leader in d.members
        && d.mode in ['casual', 'ranked']
        && d.size is int && d.size >= 2 && d.size <= 5
        && d.status in ['idle', 'queued']
        && d.createdAt is number
        && d.teams is map && d.teams.keys().hasOnly(['a', 'b'])
        && d.teams.a is list && d.teams.b is list
        && d.teams.a.size() <= d.size && d.teams.b.size() <= d.size
        && d.teams.a.size() + d.teams.b.size() == d.members.size()
        && d.members.hasAll(d.teams.a) && d.members.hasAll(d.teams.b);
    }

    /** Everything except `members` and `status` is the leader's to set, so a
     *  join or a leave must leave all of it exactly as it was. */
    function partyFramePreserved(next, prev) {
      return next.leader == prev.leader
        && next.mode == prev.mode
        && next.size == prev.size
        && next.createdAt == prev.createdAt;
    }

    match /parties/{code} {
      // Readable by any signed-in user: an invited friend has to be able to
      // look the code up before they are a member. The document holds uids and
      // a size, nothing personal — names come from `battlePlayers`.
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && validPartyCode(code)
        && validPartyShape(request.resource.data)
        && request.resource.data.leader == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.teams.a == [request.auth.uid]
        && request.resource.data.teams.b == []
        && request.resource.data.status == 'idle';
      allow update: if request.auth != null
        && validPartyShape(request.resource.data)
        && (
          // The leader runs the party: mode, size, status, and removing
          // someone. Never adding — nobody can be dragged into a party.
          (request.auth.uid == resource.data.leader
            && request.resource.data.leader == resource.data.leader
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.members.hasOnly(resource.data.members)
            && request.auth.uid in request.resource.data.members)
          // Joining: append yourself, change nothing else. Only into a party
          // that is still gathering, so nobody can slip into a live search.
          || (!(request.auth.uid in resource.data.members)
            && resource.data.status == 'idle'
            && request.resource.data.status == 'idle'
            && request.resource.data.members == resource.data.members.concat([request.auth.uid])
            // Joining picks a side for yourself and moves nobody: everyone
            // already on a side is still on it.
            && request.resource.data.teams.a.hasAll(resource.data.teams.a)
            && request.resource.data.teams.b.hasAll(resource.data.teams.b)
            && partyFramePreserved(request.resource.data, resource.data))
          // Changing sides: the room is the same people, and every player
          // except you is exactly where they were. Removing yourself from both
          // lists on each side and comparing is what makes "only you moved"
          // checkable here at all.
          || (request.auth.uid in resource.data.members
            && resource.data.status == 'idle'
            && request.resource.data.status == 'idle'
            && request.resource.data.members == resource.data.members
            && request.resource.data.teams.a.removeAll([request.auth.uid])
                 == resource.data.teams.a.removeAll([request.auth.uid])
            && request.resource.data.teams.b.removeAll([request.auth.uid])
                 == resource.data.teams.b.removeAll([request.auth.uid])
            && partyFramePreserved(request.resource.data, resource.data))
          // Leaving: remove yourself, change nothing else.
          || (request.auth.uid in resource.data.members
            && request.auth.uid != resource.data.leader
            && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
            && partyFramePreserved(request.resource.data, resource.data))
        );
      // Only the leader disbands it; a leaving member removes themselves above.
      allow delete: if request.auth != null && request.auth.uid == resource.data.leader;
    }

    // `partyQueue` used to live here: one slot per team looking for an
    // opponent. Nothing ever read two slots and paired them, so a team could
    // only ever wait in it. A room that holds both sides needs no queue, and a
    // collection no client writes should carry no rules either — leaving them
    // would keep an open write surface for a feature that no longer exists.

    /*
     * The team battle (see `src/lib/teamMatch.ts`). The document id is the
     * room's join code, so every member of that room finds the match without
     * being sent anything.
     *
     * The match carries its own roster rather than reading the room's: the room
     * is deleted the instant its leader leaves, and a match whose rules had to
     * `get()` a room would become unreadable to everyone halfway through.
     */
    match /teamMatches/{code} {
      function validTeamMatch(d) {
        return d.keys().hasOnly(['leader', 'size', 'teams', 'members', 'questionIds', 'startedAt'])
          && d.leader is string
          && d.size is int && d.size >= 2 && d.size <= 5
          && d.teams is map && d.teams.keys().hasOnly(['a', 'b'])
          && d.teams.a is list && d.teams.b is list
          // Equal, non-empty sides: the whole point of the room's start button.
          && d.teams.a.size() >= 1
          && d.teams.a.size() == d.teams.b.size()
          && d.teams.a.size() <= d.size
          && d.members is list
          && d.members.size() == d.teams.a.size() + d.teams.b.size()
          && d.members.hasAll(d.teams.a) && d.members.hasAll(d.teams.b)
          && d.questionIds is list
          && d.questionIds.size() >= 1 && d.questionIds.size() <= 30
          && d.startedAt is number;
      }

      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      // Only that room's leader starts it, and only with the sides the room
      // actually has: a match free to name any roster would let anyone stage a
      // game in other people's names and bank points against them.
      allow create: if request.auth != null
        && validTeamMatch(request.resource.data)
        && request.resource.data.leader == request.auth.uid
        && get(/databases/$(database)/documents/parties/$(code)).data.leader == request.auth.uid
        && get(/databases/$(database)/documents/parties/$(code)).data.teams == request.resource.data.teams;
      // A started match is frozen: its sides and its questions are what every
      // player's screen is already scoring against.
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == resource.data.leader;

      /*
       * One document per player, written only by that player. Within a match
       * scores only ever climb and `done` never un-sets, so a second tab, a
       * retried write or a hand-made request cannot rewind a run or replay a
       * question for points.
       *
       * `startedAt` is what makes a *second* match in the same room possible.
       * Deleting the match document does NOT delete this subcollection —
       * Firestore keeps documents whose parent is gone — so without a round
       * marker the next match in the same room would open already finished, on
       * the previous one's scores. Every run therefore carries the `startedAt`
       * of the match it belongs to, readers ignore runs from an older one, and
       * the only write allowed to reset a run to zero is one that moves it to a
       * strictly newer match.
       */
      match /players/{player} {
        function theMatch() {
          return get(/databases/$(database)/documents/teamMatches/$(code)).data;
        }
        function validRun(d) {
          return d.keys().hasOnly(['side', 'score', 'answered', 'done', 'startedAt'])
            && d.score is number && d.score >= 0
            // One question's honest maximum is 75: `answerXp` pays
            // `XP_PER_CORRECT` (30) plus `TEAM_QUESTION_SECONDS` (15) x
            // `XP_PER_SECOND_LEFT` (3). 80 leaves the same little room the
            // battle ceiling leaves, and scaling by the match's own question
            // count keeps a shorter or longer round bounded on its own terms
            // rather than against a frozen 15.
            //
            // Without this a run was `score >= 0` and nothing else, and the
            // update rule only asked that it climb — so one hand-written write
            // set a run to any number it liked and took the game for its side.
            // This is the same hole `battleMatches` had on its slots.
            && d.score <= 80 * theMatch().questionIds.size()
            && d.answered is int && d.answered >= 0
            && d.answered <= theMatch().questionIds.size()
            // The invariant that makes the per-write delta below mean something
            // on *every* path into this document, not just the common one.
            // `recordMatchAnswer` adds one answer and at most one question's
            // worth of points together, so an honest run always satisfies it —
            // while the two paths that are allowed to write a run from nothing,
            // the first `create` and the reset into a newer match, used to be
            // bounded only by the whole-match total. Either could open with the
            // maximum score and no answers, and the comment below this one
            // claimed that was impossible.
            && d.score <= 80 * d.answered
            && d.done is bool
            // Pinned to the live match, so a run can never claim to belong to a
            // round that is not the one being played.
            && d.startedAt == theMatch().startedAt;
        }
        // The side is pinned to the side the match says this player is on, so
        // nobody can score into the other team's total.
        function onOwnSide(d) {
          return (d.side == 'a' && theMatch().teams.a.hasAny([player]))
            || (d.side == 'b' && theMatch().teams.b.hasAny([player]));
        }

        allow read: if request.auth != null && request.auth.uid in theMatch().members;
        allow create: if request.auth != null
          && request.auth.uid == player
          && validRun(request.resource.data)
          && onOwnSide(request.resource.data);
        allow update: if request.auth != null
          && request.auth.uid == player
          && validRun(request.resource.data)
          && (
            // Same match: the run only ever moves forward.
            (resource.data.get('startedAt', 0) == request.resource.data.startedAt
              && request.resource.data.side == resource.data.side
              && request.resource.data.score >= resource.data.score
              // At most one question's worth per write, so the total ceiling
              // cannot be reached in a single jump either. `recordMatchAnswer`
              // adds one answer at a time, so this is the shape of the only
              // honest write there is.
              && request.resource.data.score <= resource.data.score + 80
              && request.resource.data.answered >= resource.data.answered
              && (resource.data.done == false || request.resource.data.done == true))
            // A later match in the same room: the run starts over, and the side
            // comes from the new match — people do swap sides between games.
            || (resource.data.get('startedAt', 0) < request.resource.data.startedAt
              && onOwnSide(request.resource.data))
          );
        // A run is evidence; clearing it would erase points the other side has
        // already been shown. The leader deletes the whole match instead.
        allow delete: if false;
      }
    }

    /*
     * An invitation into a room (see `src/lib/party.ts`). The document id is
     * `${code}_${to}`, so calling the same person into the same room twice
     * replaces the first invite instead of stacking another card on them.
     *
     * Two conditions make this an invitation rather than a way to message
     * strangers: the sender must be sitting in the room they are calling
     * someone into, and the two must already be accepted friends.
     */
    match /partyInvites/{inviteId} {
      function pairId(a, b) {
        return a < b ? a + '_' + b : b + '_' + a;
      }
      function areFriends(a, b) {
        return exists(/databases/$(database)/documents/friendships/$(pairId(a, b)))
          && get(/databases/$(database)/documents/friendships/$(pairId(a, b))).data.status == 'accepted';
      }

      // Only the person being called reads it. The sender has nothing to read
      // back, and a wider rule would let anyone enumerate who plays with whom.
      allow read: if request.auth != null && resource.data.to == request.auth.uid;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['code', 'from', 'to', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.code is string
        && request.resource.data.code.size() == 6
        && request.resource.data.createdAt is number
        && request.auth.uid in get(/databases/$(database)/documents/parties/$(request.resource.data.code)).data.members
        && areFriends(request.auth.uid, request.resource.data.to);

      // The invited person clears it once they have joined or do not want it;
      // the sender may take it back.
      allow delete: if request.auth != null
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }

    /* ------------------------------ ai usage ----------------------------- */
    /*
     * The daily cap on the shared Gemini key (see `api/gemini.ts`). The proxy
     * runs on Vercel with no Firebase Admin credentials by default, so it
     * cannot hold a privileged write — it increments these counters with the
     * *caller's own* ID token. That is only safe because the rules here make
     * the counter tamper-evident: it may be created at 1, may only ever go up
     * by exactly 1, and can never be deleted or reset. A user who spends their
     * 50 for the day cannot zero it back out.
     *
     * `bucket` is the uid for a per-user counter, or the literal `_shared` for
     * the global circuit-breaker. `day` is `YYYY-MM-DD`. Both writes must carry
     * exactly `{ count, day }` and nothing else.
     */
    match /aiUsage/{bucket}/days/{day} {
      // Per-user counter — only its owner ever sees or moves it.
      allow read: if request.auth != null && request.auth.uid == bucket;
      allow create: if request.auth != null && request.auth.uid == bucket
        && request.resource.data.keys().hasOnly(['count', 'day'])
        && request.resource.data.count == 1
        && request.resource.data.day == day;
      allow update: if request.auth != null && request.auth.uid == bucket
        && request.resource.data.keys().hasOnly(['count', 'day'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.day == resource.data.day;

      // Global circuit-breaker: any signed-in caller may push it up by one;
      // nobody can pull it down. Worst case a malicious client inflates it and
      // trips the day's global ceiling early — a mild griefing trade for
      // metering a shared API key with no service account at all.
      //
      // Spread over ten documents (`_shared_0` … `_shared_9`, see
      // `GLOBAL_SHARDS` in api/gemini.ts) because one document was the only
      // place in the system where ordinary requests genuinely collided, and the
      // limiter now refuses a request it cannot count instead of waving it
      // through. The bare `_shared` stays allowed so the order of the two
      // deploys cannot matter: whichever of the rules and the function lands
      // first, the other name still works.
      function isGlobalBucket() {
        return bucket == '_shared' || bucket.matches('_shared_[0-9]');
      }
      allow read: if request.auth != null && isGlobalBucket();
      allow create: if request.auth != null && isGlobalBucket()
        && request.resource.data.keys().hasOnly(['count', 'day'])
        && request.resource.data.count == 1
        && request.resource.data.day == day;
      allow update: if request.auth != null && isGlobalBucket()
        && request.resource.data.keys().hasOnly(['count', 'day'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.day == resource.data.day;
    }

    // Firestore already denies anything no `allow` matches; this states that
    // intent in the file. (It is not a backstop against a too-broad `allow`
    // elsewhere — `allow` clauses union, so a later mistake still has to be
    // caught in review, not here.)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
